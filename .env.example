# ==============================================================================
# VaultVerse Server Environment Configuration Template
# Instructions: Copy this file to server/.env and provide your secret values
# ==============================================================================

# Port configuration
PORT=5000

# MongoDB Database URI (Local daemon, MongoDB Atlas, or Docker)
MONGODB_URI=mongodb://127.0.0.1:27017/vaultverse

# JWT Authentication Secret Key (Minimum 32 characters, high entropy)
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_replace_in_production

# JWT Expiration
JWT_EXPIRES_IN=7d

# Vault Master Key (AES-256 Key Encryption Key, 64-character hexadecimal)
VAULT_MASTER_KEY=your_64_char_hexadecimal_master_key_32_bytes_replace_in_prod

# Encrypted Document Storage Directory & Storage Type (local / gridfs)
STORAGE_DIR=./uploads
STORAGE_TYPE=local

# Client Frontend URL (CORS allowed origin)
CLIENT_URL=http://localhost:5173

# Application Environment (development / production / test)
NODE_ENV=development

